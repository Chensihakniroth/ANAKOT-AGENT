{
  "name": "anakot-agent",
  "version": "1.0.0",
  "description": "An AI agent with advanced tool-calling capabilities, featuring a flexible toolsets system for organizing and managing tools.",
  "private": true,
  "workspaces": [
    "apps/*",
    "WEB_VERSION",
    "web",
    "ui-tui",
    "ui-tui/packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.cjs",
    "install:root": "npm install --workspaces=false",
    "install:web": "npm install --workspace web",
    "install:tui": "npm install --workspace ui-tui",
    "install:desktop": "npm install --workspace apps/desktop",
    "audit:root": "npm audit --workspaces=false",
    "audit:web": "npm audit --workspace web",
    "audit:tui": "npm audit --workspace ui-tui",
    "audit:fix:root": "npm audit fix --workspaces=false",
    "audit:fix:web": "npm audit fix --workspace web",
    "type-check": "npm run type-check --workspaces --if-present",
    "audit:fix:tui": "npm audit fix --workspace ui-tui",
    "dedupe-shiki": "node -e \"try{require('fs').rmSync('node_modules/@streamdown/code/node_modules/shiki',{recursive:true,force:true})}catch(e){}\" && node -e \"try{require('fs').rmSync('node_modules/@streamdown/code/node_modules/@shikijs',{recursive:true,force:true})}catch(e){}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callmemo/Anakot-Agent.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/callmemo/Anakot-Agent/issues"
  },
  "homepage": "https://github.com/callmemo/Anakot-Agent#readme",
  "dependencies": {
    "@askjo/camofox-browser": "^1.11.2",
    "@assistant-ui/react": "^0.12.28",
    "@streamdown/math": "^1.0.2",
    "agent-browser": "^0.26.0",
    "dnd-core": "^16.0.1",
    "ws": "^8.21.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "anakot-parser": "npm:hermes-parser@0.25.1",
    "shiki": "^4.0.0",
    "@shikijs/langs": "^4.0.0",
    "@shikijs/themes": "^4.0.0",
    "@shikijs/engine-javascript": "^4.0.0",
    "@shikijs/engine-oniguruma": "^4.0.0",
    "@shikijs/core": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
